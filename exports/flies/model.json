 "definitions": {
  "token": "displacement between consecutive 30 Hz positions divided by scale",
  "linear": "y = W x (+ bias where the manifest lists one), W row-major [out, in]",
  "rms_norm": "x / sqrt(mean(x^2) + norm_eps) * weight",
  "embed": "h = embed.weight token, plus neighbours(token, ...) when config.neighbours > 0",
  "neighbour_inputs": "for each other animal with a finite position and step: relative = (its position - own) / scale, displacement = its last step / scale. Keep the config.neighbours nearest by |relative|, nearest first; the rest are not visible",
  "neighbours": "per visible neighbour, f = [token_x, token_y, relative / d, log d, displacement], d = max(|relative|, 0.1); e = gelu(social.encode.2 gelu(social.encode.0 f)); weights = softmax over visible neighbours of social.score e; result = social.out (sum of weights e), zero when none is visible",
  "layer": "a = rms_norm(h, attn_norm); q, k, v = rows [0, width), [width, 2 width), [2 width, 3 width) of qkv.weight a; head i uses entries [i head_dim, (i + 1) head_dim) of each; q and k of each head go through rms_norm with q_norm and k_norm, then RoPE; h += out.weight attention(q, k, v); h += down.weight gelu(up.weight rms_norm(h, ff_norm))",
  "rope": "pairs (x[2m], x[2m + 1]) of a head vector rotated by angle position * rope_base^(-2m / head_dim), as (x0 cos - x1 sin, x0 sin + x1 cos). Scores depend only on query position minus key position",
  "attention": "per head, softmax over the current token and at most w - 1 before it of q.k / sqrt(head_dim), weights applied to v, heads concatenated, w being config.head_windows[layer][head], or config.window where it is null",
  "gelu": "exact: x / 2 (1 + erf(x / sqrt(2)))",
  "head": "raw = head.weight rms_norm(h, norm): components x [logit, mean_x, mean_y, raw_sigma_x, raw_sigma_y, raw_rho]",
  "mixture": "weights softmax(logit / temperature), sigma = softplus(raw_sigma) + sigma_floor, rho = rho_limit tanh(raw_rho), all in token units"
 },
